<!--
  Multigroup, contoller specific version of 'robot_interface.launch'.


  Usage:
    robot_multigroup_interface_streaming_fs100.launch robot_ip:=<value>
-->
<launch>
    <arg name="robot_ip" doc="IP of controller" />
    <arg name="use_bswap" default="true" doc="If true, robot driver will byte-swap all incoming and outgoing data" />

    <arg name="start_pos_tol" default="1e-4" doc="warn threshold for diff of start/current position (rad)" />
    <arg name="replace_start_pos_tol" default="0.02" doc="replace threshold for diff of start/current position (rad)" />

    <arg name="retry_traj_on_invalid_start_pos" default="0" doc="can lead to continued motion after collisions! setting this can be necessary if the robot is still moving slightly after the last move, or if a gripper action results in a robot position change in the time between trajectory generation and start" />

    <include file="$(find motoman_driver)/launch/robot_interface_streaming.launch">
        <arg name="robot_ip"  value="$(arg robot_ip)" />
        <arg name="use_bswap" value="$(arg use_bswap)" />
        <arg name="version0"  value="false" />

        <arg name="start_pos_tol"                   value="$(arg start_pos_tol)" />
        <arg name="replace_start_pos_tol"           value="$(arg replace_start_pos_tol)" />
        <arg name="retry_traj_on_invalid_start_pos" value="$(arg retry_traj_on_invalid_start_pos)" />
    </include>
</launch>
