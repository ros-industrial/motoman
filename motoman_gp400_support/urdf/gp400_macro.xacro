<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:macro name="motoman_gp400" params="prefix">

    <xacro:include filename="$(find motoman_resources)/urdf/common_materials.xacro"/>

    <!-- link list -->
    <link name="${prefix}base_link">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/base_link.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/base_link.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_1_s">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_1_s.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_1_s.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_2_l">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_2_l.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_2_l.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_2_3"/>
    <link name="${prefix}link_3_u">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_3_u.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_3_u.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_4_r">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_4_r.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_4_r.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_5_b">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_5_b.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_5_b.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_6_t">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_6_t.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_6_t.stl"/>
            </geometry>
        </collision>
    </link>
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="${prefix}joint_1_s" type="revolute">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}link_1_s"/>
        <origin xyz="0 0 0.900" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="10791" velocity="${radians(120)}"/>
    </joint>
    <joint name="${prefix}joint_2_l" type="revolute">
        <parent link="${prefix}link_1_s"/>
        <child link="${prefix}link_2_l"/>
        <origin xyz="0.400 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-55)}" upper="${radians(61)}" effort="8829" velocity="${radians(97)}"/>
    </joint>
    <joint name="${prefix}joint_2_3" type="revolute">
        <parent link="${prefix}link_2_l"/>
        <child link="${prefix}link_2_3"/>
        <origin xyz="0 0 1.050" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-61)}" upper="${radians(55)}" effort="8829" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_2_l" multiplier="-1"/>
    </joint>
    <joint name="${prefix}joint_3_u" type="revolute">
        <parent link="${prefix}link_2_3"/>
        <child link="${prefix}link_3_u"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit lower="${radians(-113)}" upper="${radians(18)}" effort="7725" velocity="${radians(97)}"/>
    </joint>
    <joint name="${prefix}joint_4_r" type="revolute">
        <parent link="${prefix}link_3_u"/>
        <child link="${prefix}link_4_r"/>
        <origin xyz="1.605 0 0.250" rpy="0 0 0" />
        <axis xyz="-1 0 0" />
        <limit lower="${radians(-360)}" upper="${radians(360)}" effort="5738" velocity="${radians(80)}"/>
    </joint>
    <joint name="${prefix}joint_5_b" type="revolute">
        <parent link="${prefix}link_4_r"/>
        <child link="${prefix}link_5_b"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit lower="${radians(-115)}" upper="${radians(115)}" effort="3920" velocity="${radians(80)}"/>
    </joint>
    <joint name="${prefix}joint_6_t" type="revolute">
        <parent link="${prefix}link_5_b"/>
        <child link="${prefix}link_6_t"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="-1 0 0" />
        <limit lower="${radians(-360)}" upper="${radians(360)}" effort="1592" velocity="${radians(172)}"/>
    </joint>
    <!-- end of joint list -->

    <!-- balancer -->
    <link name="${prefix}link_1_s_2">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_1_s_2.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_1_s_2.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_1_s_3">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_1_s_3.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <!-- collision mesh is fully contained within link_1_s -->
    </link>
    <joint name="${prefix}joint_1_s_2" type="revolute">
        <parent link="${prefix}link_1_s"/>
        <child link="${prefix}link_1_s_2"/>
        <origin xyz="-0.192 0 -0.105" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="8829" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_2_l" multiplier="-0.2366"/>
    </joint>
    <joint name="${prefix}joint_2_s_3" type="revolute">
        <parent link="${prefix}link_2_l"/>
        <child link="${prefix}link_1_s_3"/>
        <origin xyz="-0.218 0 -0.039" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="8829" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_2_l" multiplier="-1.4"/>
    </joint>

    <!-- back link -->
    <link name="${prefix}link_2_l_1">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_2_l_1.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_2_l_1.stl"/>
            </geometry>
        </collision>
    </link>
    <link name="${prefix}link_2_l_1_2"/>
    <link name="${prefix}link_2_l_2">
        <visual>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/visual/link_2_l_2.dae"/>
            </geometry>
            <xacro:material_yaskawa_blue/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://motoman_gp400_support/meshes/gp400/collision/link_2_l_2.stl"/>
            </geometry>
        </collision>
    </link>
    <joint name="${prefix}joint_2_l_1" type="revolute">
        <parent link="${prefix}link_1_s"/>
        <child link="${prefix}link_2_l_1"/>
        <origin xyz="0.400 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="7725" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_3_u" multiplier="-1.0"/>
    </joint>
    <joint name="${prefix}joint_2_l_1_2" type="revolute">
        <parent link="${prefix}link_2_l_1"/>
        <child link="${prefix}link_2_l_1_2"/>
        <origin xyz="-0.500 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="7725" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_3_u" multiplier="1.0"/>
    </joint>
    <joint name="${prefix}joint_2_l_2" type="revolute">
        <parent link="${prefix}link_2_l_1_2"/>
        <child link="${prefix}link_2_l_2"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${radians(-180)}" upper="${radians(180)}" effort="7725" velocity="${radians(97)}"/>
        <mimic joint="${prefix}joint_2_l" multiplier="1.0"/>
    </joint>
    
    <!-- ROS base_link to Robot Manufacturer World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
        <origin xyz="0 0 0.900" rpy="0 0 0"/>
        <parent link="${prefix}base_link"/>
        <child link="${prefix}base"/>
    </joint>

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="${prefix}flange" />
    <joint name="${prefix}joint_6_t-flange" type="fixed">
        <origin xyz="0.300 0 0" rpy="0 0 0" />
        <parent link="${prefix}link_6_t" />
        <child link="${prefix}flange" />
    </joint>

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}flange-tool0" type="fixed">
        <origin xyz="0 0 0" rpy="${radians(180)} ${radians(-90)} 0" />
        <parent link="${prefix}flange" />
        <child link="${prefix}tool0" />
    </joint>
</xacro:macro>
</robot>
